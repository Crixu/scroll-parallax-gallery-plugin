{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lucasr/scroll-parallax-gallery",
	"title": "Scroll Parallax Gallery",
	"category": "media",
	"icon": "images-alt2",
	"description": "Rows of images that drift sideways at different speeds as the visitor scrolls the section into view.",
	"keywords": [ "gallery", "parallax", "scroll", "images" ],
	"version": "1.0.0",
	"textdomain": "scroll-parallax-gallery",
	"attributes": {
		"rotation": {
			"type": "number",
			"default": -6
		},
		"rows": {
			"type": "array",
			"default": [
				{ "speed": -0.6, "images": [] },
				{ "speed": 0.4, "images": [] }
			]
		},
		"stickyHeight": {
			"type": "number",
			"default": 100
		},
		"scrollPerStep": {
			"type": "number",
			"default": 100
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw" ]
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		}
	},
	"editorScript": "scroll-parallax-gallery-editor",
	"editorStyle": "scroll-parallax-gallery-editor-style",
	"style": "scroll-parallax-gallery-style",
	"viewScript": "scroll-parallax-gallery-view"
}
